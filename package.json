{
	"name": "obsidian-block-view",
	"version": "1.0.0",
	"description": "An Obsidian Bases view that turns your notes into a database of blocks.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "bun test",
		"format": "prettier --write src"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@types/bun": "^1.4.5",
		"@types/node": "^26.6.6",
		"esbuild": "0.28.2",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^17.14.0",
		"jiti": "2.7.0",
		"prettier": "^3.10.1",
		"semantic-release": "^26.0.1",
		"tslib": "2.9.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0"
	},
	"dependencies": {
		"obsidian": "^1.14.4"
	},
	"engines": {
		"node": ">=26.13.0"
	},
	"packageManager": "bun@1.4.5"
}
